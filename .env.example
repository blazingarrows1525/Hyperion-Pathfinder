# ==============================================================================
# Resume Checker - Environment Configuration Example
# Copy this file to .env and configure your live credentials for deployment.
# Do NOT commit .env containing real keys to version control.
# ==============================================================================

# --- Google Gemini Configuration ---
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- OpenAI Configuration ---
# Get key: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Groq LPU Configuration (Sub-second High-Throughput Inference) ---
# Get key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Ollama Local Self-Hosted Daemon ---
# Run locally with: ollama run llama3
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3

# --- Azure AI Foundry / GitHub Models ---
GITHUB_TOKEN=your_github_token_here
AZURE_OPENAI_ENDPOINT=https://models.inference.ai.azure.com

# --- Optional Cross-Encoder Reranker ---
# Set to 'true' to activate Cross-Encoder reranking over top hybrid candidates
ENABLE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Server & CORS Configuration ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

